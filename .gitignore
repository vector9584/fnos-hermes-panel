# fnOS Hermes Agent — .gitignore
# Last updated for release: v0.20.31

# Dependencies
node_modules/

# Runtime secrets / env (generated by the app at runtime)
.env
.env.*
.env.providers
*.local
providers-state.yaml

# Build artifacts
dist/
*.fpk

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temp clone of upstream role repo (regenerated via gen_personas.py)
_agency_clone/

# Vendored upstream source (distributed via FPK, not in git)
app/hermes-src/

# FPK packages (distributed via GitHub Releases)
pkg/

# Local scratch/test files
app/ui/_check*.js
app/ui/_dup_test.js

# 本地脚本备份（dev/*.bak.YYYYmmdd-HHMMSS）
*.bak.*

# 备份文件（含 .bak-前缀 与 .bak.时间戳 两种写法）
*.bak-*
*.orig

# 一次性修复/检查脚本（不纳入版本管理）
app/ui/fix*.mjs
app/ui/_check*.js
app/ui/_dup_test.js

# 编辑备份不入库
*.bak2-*

# Python 工具缓存
dev/__pycache__/
__pycache__/
